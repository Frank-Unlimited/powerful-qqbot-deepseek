# 复制为 .env 后填写（不要提交到任何仓库）
DEEPSEEK_API_KEY=
QQ_BOT_ID=
QQ_BOT_SECRET=
# 使用哪个角色包（profiles/<名字>），默认 example
SHARK_PROFILE=example
# 火山引擎豆包语音（https://console.volcengine.com/speech/app → 语音合成大模型 → 服务接口认证信息）
VOLC_TTS_APP_ID=
VOLC_TTS_ACCESS_TOKEN=
# 智谱开放平台文生图（https://open.bigmodel.cn → 控制台 → API Keys）；cogview-3-flash 免费
ZHIPU_API_KEY=
# 火山方舟（高质量文生图 Seedream；https://console.volcengine.com/ark → API Key 管理）。和上面豆包语音的凭证不是一套
ARK_API_KEY=
# 视频链接解析（可选）：B 站登录 cookie 里的 SESSDATA，填了能下 1080P（不填 480P 左右）
BILIBILI_SESSDATA=
# 视频链接解析（可选）：抖音网页接口被风控时填浏览器里 douyin.com 的整串 cookie
DOUYIN_COOKIE=
